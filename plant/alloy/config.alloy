// DEAD AIR -- Grafana Alloy collector config.
//
// Pipeline:  plant targets  ->  scrape  ->  cardinality guard  ->  Grafana Cloud Mimir
//
// The cardinality guard is deliberately in this FIRST version of the config
// rather than retrofitted later. We are on the Grafana Cloud free tier
// (~10k active series). Per-session and per-request labels are the classic way
// a streaming plant blows that budget: one series per viewer session, per
// segment, or per request multiplies every metric by the number of live
// viewers. Those labels are dropped here, at the collector, so they never
// reach Mimir and never count toward the limit.
//
// Aggregate the dimension instead of labelling by it: count sessions in a
// gauge, don't emit a series per session.

logging {
  level  = "info"
  format = "logfmt"
}

// ---------------------------------------------------------------------------
// Targets
// ---------------------------------------------------------------------------
// Step 1: the synthetic emitter only. L1 (encoder), L2 (edges) and L3 (viewer
// fleet) get appended here as they come online -- each as another target with
// a `layer` label so dashboards can slice by plant layer.

prometheus.scrape "plant" {
  targets = [
    // L0 is not a brief layer -- the synthetic emitter is infrastructure that
    // proves the pipe, kept as a permanent canary (see cardinality guard below).
    {
      __address__ = "emitter:9101",
      job         = "deadair-plant",
      layer       = "L0-synthetic",
      component   = "emitter",
    },
    // L1: source + encoder. Exports encoder_fps, dropped_frames and
    // packager_segment_lag.
    {
      __address__ = "encoder:9103",
      job         = "deadair-plant",
      layer       = "L1",
      component   = "encoder",
    },
    // L2: the three "CDN" edges.
    //
    // Two deliberate choices here:
    //
    // 1. No `region` label on the target. Each edge stamps its own region onto
    //    its metrics; setting it in both places collides and Alloy renames one
    //    to `exported_region`, quietly splitting every per-region series in two.
    //
    // 2. `component` is unique per edge. The relabel rule below pins
    //    `instance` to `component`, and prometheus.scrape also emits synthetic
    //    per-target series (`up`, `scrape_duration_seconds`, ...) that carry no
    //    region. If all three edges shared component="edge" those synthetic
    //    series would be label-identical across three targets -- duplicate
    //    samples, rejected by remote_write.
    {
      __address__ = "edge-us-east1:8080",
      job         = "deadair-plant",
      layer       = "L2",
      component   = "edge-us-east1",
    },
    {
      __address__ = "edge-europe-west1:8080",
      job         = "deadair-plant",
      layer       = "L2",
      component   = "edge-europe-west1",
    },
    {
      __address__ = "edge-asia-south1:8080",
      job         = "deadair-plant",
      layer       = "L2",
      component   = "edge-asia-south1",
    },
    // L3: viewer fleet. Exports rebuffer_ratio and its underlying counters,
    // aggregated by region and device_class -- never per session.
    {
      __address__ = "viewers:9104",
      job         = "deadair-plant",
      layer       = "L3",
      component   = "viewers",
    },
  ]

  forward_to      = [prometheus.relabel.cardinality_guard.receiver]
  scrape_interval = "15s"
  scrape_timeout  = "10s"
}

// ---------------------------------------------------------------------------
// Cardinality guard
// ---------------------------------------------------------------------------

prometheus.relabel "cardinality_guard" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  // Drop unbounded per-entity labels before remote_write. `labeldrop` matches
  // on LABEL NAMES; the regex must be a full-string match.
  //
  //   session_id / viewer_id / client_id  -- one value per live viewer (L3)
  //   request_id / trace_id / span_id     -- one value per request
  //   segment_uri / segment_id / media_seq -- one value per 4s HLS segment,
  //                                          i.e. unbounded over time
  //   instance_ip / pod_ip                -- churns on every restart
  rule {
    action = "labeldrop"
    regex  = "session_id|viewer_id|client_id|request_id|trace_id|span_id|segment_uri|segment_id|media_seq|instance_ip|pod_ip"
  }

  // Alloy adds `instance` from __address__ (e.g. "emitter:9101"). Harmless in a
  // fixed local plant, but on GCE it becomes per-VM churn, so pin it to the
  // stable component name now rather than discovering the churn later.
  rule {
    action        = "replace"
    source_labels = ["component"]
    target_label  = "instance"
  }

  // Allowlist backstop. The brief's rule is "label only by region, rendition,
  // device_class, status; aggregate across sessions", which is an allowlist --
  // the denylist above only catches offenders we thought of. Anything not named
  // here never reaches Mimir, so a future exporter cannot invent a label that
  // quietly multiplies the series count.
  //
  //   __name__            the metric name; dropping it discards the series
  //   le / quantile       histogram and summary buckets -- REQUIRED. Dropping
  //                       `le` silently destroys every histogram, which is how
  //                       L2's segment_ttfb_seconds would break.
  //   job / instance      structural, bounded
  //   layer / component   plant topology; a handful of values (beyond the
  //                       brief's four, but bounded and useful for slicing)
  //   region / rendition / device_class / status   the brief's four
  rule {
    action = "labelkeep"
    regex  = "__name__|le|quantile|job|instance|layer|component|region|rendition|device_class|status"
  }
}

// ---------------------------------------------------------------------------
// Grafana Cloud Mimir
// ---------------------------------------------------------------------------

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_MIMIR_URL")

    basic_auth {
      username = sys.env("GRAFANA_MIMIR_USER")
      password = sys.env("GRAFANA_CLOUD_METRICS_TOKEN")
    }

    // Small plant, free tier: keep batches modest so a burst of new series
    // surfaces as a visible 429 rather than a silent stall.
    queue_config {
      capacity             = 2500
      max_shards           = 3
      max_samples_per_send = 500
    }
  }

  // `cluster` and `env` are added at write time so every DEAD AIR series is
  // attributable, without each exporter having to know where it runs.
  external_labels = {
    project = "dead-air",
    env     = sys.env("DEADAIR_ENV"),
  }
}

// ---------------------------------------------------------------------------
// Logs: nginx origin access log -> Grafana Cloud Loki
// ---------------------------------------------------------------------------
// This is the other half of the cardinality split. Metrics stay low-cardinality
// by aggregating across sessions; the per-request detail that was stripped from
// Mimir lives here, where high-cardinality data belongs. The agent's triage
// needs both -- "which segment 404'd for whom" is a log question, not a metric
// question.
//
// The same discipline applies to Loki LABELS: a Loki label is as expensive as a
// Prometheus label. Per-request fields (uri, segment, remote_addr, session)
// stay in the log LINE, which is indexed cheaply and queryable with LogQL
// filters. Only bounded values become labels.

local.file_match "origin_access" {
  path_targets = [
    {
      __path__  = "/var/log/deadair/access.log",
      job       = "deadair-origin",
      layer     = "L1",
      component = "origin",
    },
  ]
}

loki.source.file "origin_access" {
  targets    = local.file_match.origin_access.targets
  forward_to = [loki.process.origin_access.receiver]
}

// L3 QoE beacons. This is the other half of the §5 cardinality split: the
// per-session detail that is deliberately absent from Mimir lives here, with
// session_id in the log LINE and never as a label.
local.file_match "viewer_beacons" {
  path_targets = [
    {
      __path__  = "/var/log/deadair/viewers.log",
      job       = "deadair-viewers",
      layer     = "L3",
      component = "viewers",
    },
  ]
}

loki.source.file "viewer_beacons" {
  targets    = local.file_match.viewer_beacons.targets
  forward_to = [loki.process.viewer_beacons.receiver]
}

loki.process "viewer_beacons" {
  forward_to = [loki.write.grafana_cloud.receiver]

  stage.json {
    expressions = {
      region       = "region",
      device_class = "device_class",
      rendition    = "rendition",
    }
  }

  // Only bounded fields become labels. session_id stays in the line: one label
  // value per viewer session is precisely the explosion the metrics guard
  // exists to prevent, and Loki labels are no cheaper than Prometheus ones.
  stage.labels {
    values = {
      region       = "",
      device_class = "",
      rendition    = "",
    }
  }
}

loki.process "origin_access" {
  forward_to = [loki.write.grafana_cloud.receiver]

  // nginx writes JSON (see plant/origin/nginx.conf), so parse it out for
  // structured querying...
  stage.json {
    expressions = {
      status   = "status",
      uri      = "uri",
      rendition = "rendition",
    }
  }

  // ...but promote only bounded fields to labels. `status` is one of a handful
  // of codes; `rendition` is one of four ladder rungs. `uri` deliberately stays
  // in the line: one label value per segment filename would be unbounded.
  stage.labels {
    values = {
      status    = "",
      rendition = "",
    }
  }
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_METRICS_TOKEN")
    }
  }

  external_labels = {
    project = "dead-air",
    env     = sys.env("DEADAIR_ENV"),
  }
}
