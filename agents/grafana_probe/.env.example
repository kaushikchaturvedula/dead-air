# Copy to .env in this directory and fill in. .env is gitignored -- never commit it.
#
#   cp .env.example .env

# --- Gemini via Vertex AI ---
# DEAD AIR uses Google Cloud AI tooling only. TRUE routes google-genai through
# Vertex AI rather than the public Gemini API.
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Your Google Cloud project ID.
GOOGLE_CLOUD_PROJECT=your-project-id

# Vertex AI region.
GOOGLE_CLOUD_LOCATION=us-central1

# --- Grafana Cloud ---
# The Grafana stack the hosted MCP server should query. Sent as the
# X-Grafana-URL header to https://mcp.grafana.com/mcp. Authentication itself is
# handled by an OAuth browser handshake on first connect -- no token goes here.
GRAFANA_STACK_URL=https://deadair.grafana.net
