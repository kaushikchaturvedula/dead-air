# Copy to .env in this directory and fill in. .env is gitignored -- never commit it.
#
#   cp .env.example .env

# --- Gemini via Vertex AI ---
# DEAD AIR uses Google Cloud AI tooling only. TRUE routes google-genai through
# Vertex AI rather than the public Gemini API.
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Your Google Cloud project ID.
GOOGLE_CLOUD_PROJECT=your-project-id

# Vertex AI location. Use `global` -- Gemini 3.x flash models are served from
# there only. Regional endpoints such as us-central1 top out at gemini-2.5-flash.
GOOGLE_CLOUD_LOCATION=global

# Gemini model for the probe agent. Must be a real Vertex model ID: the
# `gemini-flash-latest` alias is AI Studio-only and 404s on Vertex.
# Verified responding on location=global: gemini-3.7-flash, gemini-3.6-flash,
# gemini-3.5-flash, gemini-2.5-flash.
GEMINI_MODEL=gemini-3.7-flash

# --- Grafana ---
# DEAD AIR runs the Grafana MCP server SELF-HOSTED (see docker-compose.yml at
# the repo root). The hosted mcp.grafana.com endpoint requires an interactive
# OAuth 2.1 browser handshake with no service-account option, so it cannot
# back a headless agent triggered by an alert webhook.

# The Grafana stack the MCP server queries. Read by the mcp-grafana container.
GRAFANA_URL=https://deadair.grafana.net

# Grafana Cloud service-account token (starts with glsa_). Create one under
# Administration > Users and access > Service accounts. NEVER commit this;
# this .env file is gitignored.
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_your_token_here

# Where the ADK agent reaches the MCP server. Default matches the port mapping
# in docker-compose.yml.
GRAFANA_MCP_URL=http://localhost:8010/mcp

# OPTIONAL: bearer token protecting the MCP server itself (any random string;
# not a Grafana credential). The server is localhost-only here so this is off
# by default, but upstream says serving without it will become a startup error
# in a future release. Uncomment to enable -- both the server (via compose
# env_file) and the agent pick it up from this one line.
# MCP_GRAFANA_SERVER_TOKEN=choose-a-random-string
